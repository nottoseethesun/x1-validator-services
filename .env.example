# Credentials that belong to one install. Copy this file to .env in the
# project root, fill in what you use, and make it readable only by you:
#   cp .env.example .env && chmod 600 .env
# git ignores .env. See README.md, Credentials.

# x1-validator-private-rpc: the Cronitor telemetry url of the monitor that
# watches `ensure`. Leave it empty for no heartbeat. See
# x1-validator-private-rpc/README.md, Cronitor Heartbeat.
X1_PRIVATE_RPC_CRONITOR_URL=
